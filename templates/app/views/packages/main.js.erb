const { app, BrowserWindow, shell } = require("electron");
const configuredUrl = require("./app-url");

const APP_URL = process.env.ELECTRON_APP_URL || configuredUrl;
const APP_ORIGIN = new URL(APP_URL).origin;

function createWindow() {
  const window = new BrowserWindow({
    width: <%= config.fetch(:electron).fetch(:window_width) %>,
    height: <%= config.fetch(:electron).fetch(:window_height) %>,
    minWidth: <%= config.fetch(:electron).fetch(:window_min_width) %>,
    minHeight: <%= config.fetch(:electron).fetch(:window_min_height) %>,
    autoHideMenuBar: true,
    webPreferences: {
      contextIsolation: true,
      sandbox: true,
      nodeIntegration: false
    }
  });

  window.webContents.setWindowOpenHandler(({ url }) => {
    if (new URL(url).origin === APP_ORIGIN) {
      return { action: "allow" };
    }

    shell.openExternal(url);
    return { action: "deny" };
  });

  window.loadURL(APP_URL);
}

app.whenReady().then(() => {
  createWindow();

  app.on("activate", () => {
    if (BrowserWindow.getAllWindows().length === 0) createWindow();
  });
});

app.on("window-all-closed", () => {
  if (process.platform !== "darwin") app.quit();
});
