{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "<%= config.fetch(:tauri).fetch(:app_name) %>",
  "version": "<%= config.fetch(:tauri).fetch(:version) %>",
  "identifier": "<%= config.fetch(:tauri).fetch(:product_id) %>",
  "build": {
    "frontendDist": "<%= config.fetch(:tauri).fetch(:app_url) %>",
    "devUrl": "<%= config.fetch(:tauri).fetch(:app_url) %>"
  },
  "app": {
    "windows": [
      {
        "title": "<%= config.fetch(:tauri).fetch(:app_name) %>",
        "width": <%= config.fetch(:tauri).fetch(:window_width) %>,
        "height": <%= config.fetch(:tauri).fetch(:window_height) %>,
        "minWidth": <%= config.fetch(:tauri).fetch(:window_min_width) %>,
        "minHeight": <%= config.fetch(:tauri).fetch(:window_min_height) %>,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "<%= config.fetch(:tauri).fetch(:category) %>",
    "shortDescription": "<%= config.fetch(:tauri).fetch(:summary) %>"
  }
}
