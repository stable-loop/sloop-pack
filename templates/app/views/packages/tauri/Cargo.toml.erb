[package]
name = "<%= config.fetch(:product_tag) %>"
version = "<%= config.fetch(:version) %>"
description = "<%= config.fetch(:summary) %>"
authors = ["<%= config.fetch(:developer) %>"]
edition = "2021"

[lib]
name = "<%= config.fetch(:product_tag) %>_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = [] }
